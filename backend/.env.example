# ==============================================================================
# AI Voice Language Tutor - Environment Configuration
# ==============================================================================
# The application includes a Zero-Failure Architecture with client-side Web Speech
# recognition, intelligent linguistic grammar diagnostics, and native SpeechSynthesis.
# If cloud API credits are exhausted (429), the app gracefully switches to local processing.

# Cloud Provider (Optional: Active OpenAI Key with credits)
OPENAI_API_KEY=your_openai_api_key_here

# Server Configuration
PORT=5000
CLIENT_URL=http://localhost:5173

# Optional Model Configuration (defaults provided in code)
OPENAI_STT_MODEL=whisper-1
OPENAI_LLM_MODEL=gpt-4o-mini
OPENAI_TTS_MODEL=tts-1
OPENAI_TTS_VOICE=alloy
